{
  "manifest_version": 2,
  "name": "FB Marketplace Chat Filter",
  "version": "1.0.0",
  "description": "Filter Facebook Marketplace Messenger chats by listing name",
  "browser_specific_settings": {
    "gecko": {
      "id": "fb-marketplace-chat-filter@example.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "https://www.facebook.com/*",
    "https://www.messenger.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/marketplace/*",
        "https://www.facebook.com/messages/*",
        "https://www.messenger.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
